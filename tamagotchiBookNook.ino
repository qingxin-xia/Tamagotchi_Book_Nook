                    drawIndexedFrame(&tft1, 0, 0, 6, BOT_L_WIDTH, FRAME_HEIGHT, tap[botLFrameNum]);
                } else {
                    switchToIdle();
                }  
                break;
            case 2:
                if (!duckInTop) {
                    if (botLFrameNum != 7) {
                        botLFrameNum ++;
                        botLDuration = botNeckStretchDurations[botLFrameNum];
                        drawIndexedFrame(&tft1, 0, 0, 6, BOT_L_WIDTH, FRAME_HEIGHT, botNeckStretch[botLFrameNum]);
                    } else { // don't increment, let it loop
                        duckInTop = true;
                        botLFrameNum = 0;
                        botLDuration = topNeckStretchDurations[botLFrameNum];
                        drawIndexedFrame(&tft2, 0, 0, 6, TOP_L_WIDTH, FRAME_HEIGHT, topNeckStretch[botLFrameNum]);
                    }  
                } 
                break;
            case 3:
                if (!duckInTop) {
                    if (botLFrameNum != 1) {
                        botLFrameNum --;
                        botLDuration = botNeckStretchDurations[botLFrameNum];
                        drawIndexedFrame(&tft1, 0, 0, 6, BOT_L_WIDTH, FRAME_HEIGHT, botNeckStretch[botLFrameNum]);
                    } else {
                        switchToIdle();
                        duckInTop = false;
                    }  
                }
                break;
        }
    }
    botLDuration -= FRAME_RATE;
}
void touchSensorResponse(){
    botSensorStatue = digitalRead(botSensorPin);
    topSensorStatue = digitalRead(topSensorPin);
    // if sensor is touched, SensorStatue is HIGH:
   
    if (botSensorStatue == HIGH) {
      botCount++;
      Serial.print("BOTTOM SENSOR TOUCHED!");
      Serial.println(botCount);
      botTap = true;
    }
    if (topSensorStatue == HIGH) {
      topCount++;
      Serial.print("TOP SENSOR TOUCHED!");
      Serial.println(topCount);
      topTap = true;
    }
    drawDucks(botTap, topTap);
    botTap = false;
    topTap = false;
}


void setup() {
    // OLED
    if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) { // Address 0x3D for 128x64
        Serial.println(F("SSD1306 allocation failed"));
        for(;;);
    }
    // settling time
    delay(2000);
    display.clearDisplay();
    //display.setTextSize(1);
    display.setFont(&FreeSerif9pt7b);
    display.setTextColor(WHITE);
    display.setCursor(10, 30);
    display.println("Hello, world!!! Testing!");
    display.display();


    // BUTTON
    // button press pulls pin LOW so configure HIGH
    pinMode(Button_pin,INPUT_PULLUP);
    pinMode(Order_button_pin,INPUT_PULLUP);
    // use an interrupt to sense when the button is pressed
    attachInterrupt(digitalPinToInterrupt(Button_pin), senseButtonPressed, FALLING);
    attachInterrupt(digitalPinToInterrupt(Order_button_pin), senseOrderButtonPressed, FALLING);
    #if (SerialDebugging)
    Serial.begin(115200); while (!Serial); Serial.println();
    #endif
    // settling time
    delay(250);
    // ignore any power-on-reboot garbage
    isButtonPressed = false;
    isOrderButtonPressed = false;
    


    // LCD
    // SPI speed defaults to SPI_DEFAULT_FREQ defined in the library, you can override it here
    // Note that speed allowable depends on chip and quality of wiring, if you go too fast, you
    // may end up with a black screen some times, or all the time.
    //tft1.setSPISpeed(40000000);

    // initialise the display
    tft1.init(240, 320);           // Init ST7789 320x240
    tft1.setRotation(1);           // Force landscape mode (320x240 view)
    tft1.fillScreen(Display_Backround_Color);

    tft2.init(240, 320);           
    tft2.setRotation(1);    
    tft2.fillScreen(Display_Backround_Color);

    // the display is now on
    isDisplayVisible = true;
    topLDuration = kittenDurations[0];
    topRDuration = catDurations[0];
    botLDuration = duckDurations[0];
    botRDuration = foodDurations[0];

    drawIndexedFrame(&tft2, 0, 0, 6, TOP_L_WIDTH, FRAME_HEIGHT, kitten[topLFrameNum]);
    drawIndexedFrame(&tft2, 0, 0, 6, TOP_R_WIDTH, FRAME_HEIGHT, cat[topRFrameNum]);
    drawIndexedFrame(&tft1, 0, 0, 6, BOT_L_WIDTH, FRAME_HEIGHT, duck[botLFrameNum]);
    drawIndexedFrame(&tft1, BOT_L_WIDTH * 6, 0, 6, BOT_R_WIDTH, FRAME_HEIGHT, food[botRFrameNum]);


    
    // TOUCH SENSOR
    pinMode(botSensorPin, INPUT);
    pinMode(topSensorPin, INPUT);
}


void loop() {

    //unconditional display, regardless of whether display is visible
    //displayUpTime();
    drawCats();
    if (isOrderButtonPressed) {
        drawFood(true);
        isOrderButtonPressed = false;
        #if (SerialDebugging)
        Serial.print("Switched food to ");
        Serial.println(currentFood);
        #endif
    }
    drawFood(false);
    // draw ducks over cats
    touchSensorResponse();

    // has the button been pressed?
    if (isButtonPressed) {
        
        // yes! toggle display visibility
        isDisplayVisible = !isDisplayVisible;

        // apply
        tft1.enableDisplay(isDisplayVisible);
        tft2.enableDisplay(isDisplayVisible);

        #if (SerialDebugging)
        Serial.print("button pressed @ ");
        Serial.print(millis());
        Serial.print(", display is now ");
        Serial.println((isDisplayVisible ? "ON" : "OFF"));
        #endif

        // confirm button handled
        isButtonPressed = false;
    }

    delay(DELAY); //the above code takes time to execute, so modify this to fit your hardware and animation
}
