void senseButtonPressed() {
    if (!isButtonPressed) {
        isButtonPressed = true;
    }
}
void senseOrderButtonPressed() {
    if (!isOrderButtonPressed) {
        isOrderButtonPressed = true;
    }
}
void displayUpTime() {

    // calculate seconds, truncated to the nearest whole second
    unsigned long upSeconds = millis() / 1000;

    // calculate days, truncated to nearest whole day
    unsigned long days = upSeconds / 86400;

    // the remaining hhmmss are
    upSeconds = upSeconds % 86400;

    // calculate hours, truncated to the nearest whole hour
    unsigned long hours = upSeconds / 3600;

    // the remaining mmss are
    upSeconds = upSeconds % 3600;

    // calculate minutes, truncated to the nearest whole minute
    unsigned long minutes = upSeconds / 60;

    // the remaining ss are
    upSeconds = upSeconds % 60;

    // allocate a buffer
    char newTimeString[MaxString] = { 0 };

    // construct the string representation
    sprintf(
        newTimeString,
        "%lu %02lu:%02lu:%02lu",
        days, hours, minutes, upSeconds
    );

    // has the time string changed since the last tft update?
    if (strcmp(newTimeString,oldTimeString) != 0) {

        // yes! home the cursor
        tft1.setCursor(0,0);

        // change the text color to the background color
        tft1.setTextColor(Display_Backround_Color);

        // redraw the old value to erase
        tft1.print(oldTimeString);

        // home the cursor
        tft1.setCursor(0,0);
        
        // change the text color to foreground color
        tft1.setTextColor(0xEF7D);
    
        // draw the new time value
        tft1.print(newTimeString);
    
        // and remember the new value
        strcpy(oldTimeString,newTimeString);
    }
}
void drawIndexedFrame( Adafruit_ST7789 * tft, int startX, int startY, int scale, int srcWidth, int srcHeight, const uint8_t * frame_data) {

  int scaledWidth = srcWidth * scale;
  // Lock the SPI bus open to eliminate chip-select switching overhead
  tft->startWrite();
  tft->setAddrWindow(startX, startY, scaledWidth, srcHeight * scale);
  // Temporary buffer for one row
  uint16_t rowBuffer[scaledWidth]; 

  for (int y = 0; y < srcHeight; y++) {
    int src_row_offset = y * srcWidth;
    int buffer_idx = 0;

    // Build one scaled row in RAM first
    for (int x = 0; x < srcWidth; x++) {
      uint16_t color = palette[frame_data[src_row_offset + x]];
      for (int c = 0; c < scale; c++) {
        rowBuffer[buffer_idx++] = color;
      }
    }
    
    // Push row to multiple times to scale vertically
    // writePixels automatically handles SPI D/C pin toggling and is heavily optimized
    for (int r = 0; r < scale; r++) {
      tft->writePixels(rowBuffer, scaledWidth);
    }
  }
  tft->endWrite();
}
// botRFrameNum refers to the frame within all food frames, not just the frames of the current food
void drawFood(bool switchFood){
    if (switchFood) {
        currentFood = rand() % 6; // 6 food animations
        botRFrameNum = foodStartEnd[currentFood][0];
        botRDuration = foodDurations[botRFrameNum]; 
        drawIndexedFrame(&tft1, BOT_L_WIDTH * 6, 0, 6, BOT_R_WIDTH, FRAME_HEIGHT, food[botRFrameNum]);
    } else if (botRDuration <= 0){
        if (botRFrameNum != foodStartEnd[currentFood][1]) {
            botRFrameNum ++; 
        } else {
            botRFrameNum = foodStartEnd[currentFood][0];
        }
        botRDuration = foodDurations[botRFrameNum]; 
        drawIndexedFrame(&tft1, BOT_L_WIDTH * 6, 0, 6, BOT_R_WIDTH, FRAME_HEIGHT, food[botRFrameNum]);
    }
    botRDuration -= FRAME_RATE;
}
void drawCats() {
    if (topRDuration <= 0) {
        if (topRFrameNum != 6) {
            topRFrameNum ++;
        } else {
            topRFrameNum = 0;
        }   
        topRDuration = catDurations[topRFrameNum];
        drawIndexedFrame(&tft2, TOP_L_WIDTH*6, 0, 6, TOP_R_WIDTH, FRAME_HEIGHT, cat[topRFrameNum]);
    }
    if (topLDuration <= 0) {
        if (duckInTop && currentState == 2) { // draw the duck ascent
            if (topLFrameNum != 7) { 
                topLFrameNum ++;
                topLDuration = topNeckStretchDurations[topLFrameNum];
                drawIndexedFrame(&tft2, 0, 0, 6, TOP_L_WIDTH, FRAME_HEIGHT, topNeckStretch[topLFrameNum]);
            } else { // don't increment, let it loop
                topLDuration += 50; // negates the decrement; we don't want the int to go out of bounds over long periods of time
                stateCanChange = true;
            }  
        } else if (duckInTop && currentState == 3) { 
            if (topLFrameNum != 11) { // first draw descent on the top screen
                topLFrameNum ++;
                topLDuration = topNeckStretchDurations[topLFrameNum];
                drawIndexedFrame(&tft2, 0, 0, 6, TOP_L_WIDTH, FRAME_HEIGHT, topNeckStretch[topLFrameNum]);
            } else {
                topLFrameNum = 0;
                duckInTop = false;
                botLFrameNum = 7;
                botLDuration = botNeckStretchDurations[botLFrameNum];
                drawIndexedFrame(&tft1, 0, 0, 6, BOT_L_WIDTH, FRAME_HEIGHT, botNeckStretch[botLFrameNum]);
            }
        } else {
            if (topLFrameNum != 3) { // draw the top ascent
                topLFrameNum ++;
                topLDuration = topNeckStretchDurations[topLFrameNum];
                drawIndexedFrame(&tft2, 0, 0, 6, TOP_L_WIDTH, FRAME_HEIGHT, kitten[topLFrameNum]);
            } else { // don't increment, let it loop
                topLDuration += 50; // negates the decrement; we don't want the int to go out of bounds over long periods of time
                stateCanChange = true;
            }  
        }
    }
    
    topLDuration -= FRAME_RATE;
    topRDuration -= FRAME_RATE;
}
void switchToIdle() {
    botLFrameNum = 0;
    botLDuration = duckDurations[botLFrameNum];
    drawIndexedFrame(&tft1, 0, 0, 6, BOT_L_WIDTH, FRAME_HEIGHT, duck[botLFrameNum]);
    currentState = 0;
    stateCanChange = true;
}
